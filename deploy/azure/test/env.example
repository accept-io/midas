# MIDAS dedicated Azure test environment variable contract.
# Do not paste secrets into this file. Store secret values in Azure Container
# App secrets or an approved secret store.

# Required runtime posture.
MIDAS_STORE_BACKEND=postgres
MIDAS_DATABASE_URL=secretref:midas-test-database-url
MIDAS_AUTH_MODE=required
MIDAS_AUTH_TOKENS=secretref:midas-test-auth-tokens
MIDAS_METRICS_ENABLED=true
MIDAS_METRICS_PATH=/metrics

# Demo seeding must stay disabled in the test environment.
MIDAS_DEV_SEED_DEMO_DATA=false
MIDAS_DEV_SEED_DEMO_USER=false
MIDAS_DEV_SEED_SYNTHETIC_DRIFT=false

# HTTP/runtime safety.
MIDAS_HTTP_HANDLER_TIMEOUT=30s

# Initial Tier 1 availability-capable test posture. These limits are per
# replica, so 3 to 6 replicas can request 60 to 120 open DB connections before
# headroom, operator sessions, maintenance, and future dispatcher/eventing
# connections.
MIDAS_DATABASE_MAX_OPEN_CONNS=20
MIDAS_DATABASE_MAX_IDLE_CONNS=5
MIDAS_DATABASE_CONN_MAX_LIFETIME=30m
MIDAS_DATABASE_CONN_MAX_IDLE_TIME=5m

# Base revision: dispatcher disabled until Event Hubs and a test consumer are
# provisioned. This still validates transactional outbox row creation and
# backlog metrics.
MIDAS_DISPATCHER_ENABLED=false
MIDAS_DISPATCHER_PUBLISHER=none
MIDAS_DISPATCHER_BATCH_SIZE=100
MIDAS_DISPATCHER_POLL_INTERVAL=2s
MIDAS_DISPATCHER_MAX_BACKOFF=30s

# Dispatcher-on validation revision. Enable only after Event Hubs Kafka secrets
# and consumer-side deduplication checks are ready.
# MIDAS_DISPATCHER_ENABLED=true
# MIDAS_DISPATCHER_PUBLISHER=kafka
# MIDAS_KAFKA_BROKERS=<event-hubs-namespace>.servicebus.windows.net:9093
# MIDAS_KAFKA_CLIENT_ID=midas-test
# MIDAS_KAFKA_REQUIRED_ACKS=-1
# MIDAS_KAFKA_WRITE_TIMEOUT=10s
# MIDAS_KAFKA_TLS_ENABLED=true
# MIDAS_KAFKA_SASL_MECHANISM=plain
# MIDAS_KAFKA_SASL_USERNAME='$ConnectionString'
# MIDAS_KAFKA_SASL_PASSWORD=secretref:eventhubs-send-connection-string
